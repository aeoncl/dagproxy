#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
    if command -v systemctl >/dev/null 2>&1; then

        # The unit is a user unit. Enable it globally so it starts at login
        # for every user, then (re)start it for users already logged in so
        # it runs right away and picks up a new binary/unit on upgrade.
        systemctl --global enable dagproxy.service >/dev/null 2>&1 || true

        if command -v loginctl >/dev/null 2>&1; then
            for user in $(loginctl list-users --no-legend 2>/dev/null | awk '{print $2}'); do
                systemctl --user --machine="${user}@" daemon-reload >/dev/null 2>&1 || true
                systemctl --user --machine="${user}@" restart dagproxy.service >/dev/null 2>&1 || true
            done
        fi
    fi

    cat <<'EOF'

DagProxy installed & started.

  * Edit the config at:      /etc/dagproxy/config.json
  * Restart the service with: systemctl --user restart dagproxy

EOF
fi

exit 0
